{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "flutter",
  "name": "Flutter",
  "version": "0.2.0",
  "description": "Flutter and Dart support for Orca",
  "author": { "name": "Tiago Danin" },
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": { "orca": ">=1.4.259" },
  "pluginApi": 1,
  "main": "main.mjs",
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "terminal:send" },
    { "kind": "terminal:read" },
    { "kind": "storage:own" }
  ],
  "contributes": {
    "panels": [
      { "id": "flutter", "title": "Flutter", "icon": "layers", "entry": "src/panel.tsx", "ui": "components" }
    ],
    "commands": [
      { "id": "flutter.run", "title": "Flutter: Run", "when": "workspace" },
      { "id": "flutter.stop", "title": "Flutter: Stop", "when": "workspace" },
      { "id": "flutter.hotReload", "title": "Flutter: Hot Reload", "when": "workspace" },
      { "id": "flutter.hotRestart", "title": "Flutter: Hot Restart", "when": "workspace" },
      { "id": "flutter.nextDevice", "title": "Flutter: Next Device", "when": "workspace" },
      { "id": "flutter.pubGet", "title": "Flutter: Pub Get", "when": "workspace" },
      { "id": "flutter.buildRunner", "title": "Flutter: Run build_runner", "when": "workspace" },
      { "id": "flutter.clean", "title": "Flutter: Clean", "when": "workspace" },
      { "id": "flutter.createProject", "title": "Flutter: Create Project", "when": "workspace" },
      { "id": "flutter.doctor", "title": "Flutter: Run Flutter Doctor", "when": "workspace" },
      { "id": "flutter.upgrade", "title": "Flutter: Run Flutter Upgrade", "when": "workspace" },
      { "id": "flutter.test", "title": "Flutter: Run Tests", "when": "workspace" },
      { "id": "flutter.testCoverage", "title": "Flutter: Run Tests with Coverage", "when": "workspace" }
    ],
    "keybindings": [
      { "command": "flutter.run", "key": "Mod+Shift+X", "when": "workspace" },
      { "command": "flutter.hotReload", "key": "Mod+Shift+L", "when": "workspace" },
      { "command": "flutter.hotRestart", "key": "Mod+Shift+K", "when": "workspace" },
      { "command": "flutter.doctor", "key": "Mod+Shift+S", "when": "workspace" },
      { "command": "flutter.test", "key": "Mod+Shift+U", "when": "workspace" },
      { "command": "flutter.createProject", "key": "Mod+Shift+P", "when": "workspace" }
    ],
    "statusBarItems": [
      {
        "id": "device",
        "text": "No device",
        "icon": "rocket",
        "tooltip": "Flutter device. Press to switch to the next one.",
        "command": "flutter.nextDevice"
      },
      { "id": "state", "text": "Flutter: Idle", "icon": "layers", "tooltip": "Flutter run state" }
    ],
    "syntaxes": [
      {
        "id": "dart",
        "title": "Dart",
        "scopeName": "source.dart",
        "path": "syntaxes/dart.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [".dart"]
      }
    ]
  }
}
